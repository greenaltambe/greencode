########################################
# Environment
########################################

NODE_ENV=development

########################################
# JWT
########################################

JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRE=30d

########################################
# Judge Authentication
########################################

JUDGE_SERVICE_SECRET=shared-secret-between-backend-and-judge

########################################
# Storage Configuration
########################################

# local | minio | s3
STORAGE_TYPE=local

########################################
# MinIO Credentials
########################################

MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=problems

########################################
# AWS S3 (Optional)
########################################

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

########################################
# Frontend
########################################

VITE_API_URL=http://localhost:5000/api

########################################
# SMTP Email Configuration (Nodemailer)
# Configure SMTP host, port, user, and password to send emails.
########################################

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM="GreenCode <your-email@gmail.com>"
FRONTEND_URL=http://localhost:5173

########################################
# Initial Admin Account Settings
########################################
INITIAL_ADMIN_NAME=Greenal
INITIAL_ADMIN_EMAIL=admin@gmail.com
INITIAL_ADMIN_PASSWORD=greenaladmin