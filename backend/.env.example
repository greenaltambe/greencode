########################################
# Environment
########################################

NODE_ENV=development
MONGODB_URI=

########################################
# JWT
########################################

JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRE=30d

########################################
# Judge Authentication
########################################

JUDGE_SERVICE_SECRET=shared-secret-between-backend-and-judge

########################################
# Storage Configuration
########################################

# local | minio | s3
STORAGE_TYPE=local

########################################
# MinIO Credentials
########################################

MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=problems

########################################
# AWS S3 (Optional)
########################################

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

########################################
# Cloudflare R2 (Optional)
########################################

R2_ENDPOINT=https://75bfbf5e922ea14ccbd39c9e01fc4c50.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=online-judge

########################################
# Frontend
########################################

VITE_API_URL=http://localhost:5000/api

########################################
# SMTP Email Configuration (Nodemailer)
# Configure SMTP host, port, user, and password to send emails.
########################################

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM="GreenCode <your-email@gmail.com>"
FRONTEND_URL=http://localhost:5173

########################################
# Initial Admin Account Settings
########################################
INITIAL_ADMIN_NAME=Greenal
INITIAL_ADMIN_EMAIL=admin@gmail.com
INITIAL_ADMIN_PASSWORD=greenaladmin

########################################
# System Defaults & Execution Limits
########################################
PORT=5000
MONGODB_URI=mongodb://localhost:27017/online-judge
REDIS_URL=redis://localhost:6379
CORS_ORIGIN=http://localhost:5173
MAX_MEMORY=256m
MAX_CPU=0.5
EXECUTION_TIMEOUT=5